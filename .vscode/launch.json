{
  // Pola jnn_mobile: args --flavor (native Android/iOS).
  // cwd/program: monorepo root → proyek Flutter di mobile/.
  //
  // Local debug: floating DevTool overlay aktif (termasuk Production).
  // Production flavor → API https://api.sambasku.com (bukan staging).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Staging",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main.dart",
      "noDebug": true,
      "args": ["--flavor", "staging"]
    },
    {
      "name": "Staging (Screenshot)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main.dart",
      "noDebug": true,
      "args": [
        "--flavor",
        "staging",
        "--dart-define=SCREENSHOT_MODE=true"
      ]
    },
    {
      "name": "Staging (Debug)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "openDevTools": "flutter",
      "args": ["--flavor", "staging"]
    },
    {
      "name": "Staging (Profile)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "args": ["--flavor", "staging"]
    },
    {
      "name": "Production (Debug)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "openDevTools": "flutter",
      "args": ["--flavor", "production"]
    },
    {
      "name": "Production (Profile)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "args": ["--flavor", "production"]
    }
  ]
}
