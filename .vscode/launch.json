{
  // Pola jnn_mobile: args --flavor (native Android/iOS).
  // cwd/program: monorepo root → proyek Flutter di mobile/.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Staging",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main.dart",
      "noDebug": true,
      "args": ["--flavor", "staging"]
    },
    {
      "name": "Staging (Debug)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": ["--flavor", "staging"]
    },
    {
      "name": "Staging (Profile)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "args": ["--flavor", "staging"]
    },
    {
      "name": "Production (Debug)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": ["--flavor", "production"]
    },
    {
      "name": "Production (Profile)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "args": ["--flavor", "production"]
    }
  ]
}
